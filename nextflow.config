manifest {
    name            = 'PhyloBot'
    description     = 'Does the alignment tool change the evolutionary tree? ClustalW vs T-Coffee on viral RdRp domains.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.0.0'
}

params {
    accessions     = "${projectDir}/data/accessions.txt"
    regions        = "${projectDir}/data/rdrp_domain_regions.tsv"
    regions_format = 'regions'          // or 'interproscan' for a raw InterProScan TSV
    names          = "${projectDir}/data/virus_names.tsv"
    domains        = null               // skip the download: start from domain sequences
    outdir         = 'results'
    bootstraps     = 1000               // ultrafast bootstrap replicates (IQ-TREE needs >= 1000)
    seed           = 20241125           // fixed seed so reruns give the same trees
    iqtree_model   = 'MFP'              // ModelFinder picks the substitution model
    iqtree_extra   = ''
}

process {
    cpus = 1
    withLabel: 'align' { cpus = { Math.min(2, Runtime.runtime.availableProcessors()) } }
    withLabel: 'tree'  { cpus = { Math.min(4, Runtime.runtime.availableProcessors()) } }
}

profiles {
    // Tools already on PATH (apt, brew or a conda env you activated yourself).
    local {
        process.executor = 'local'
    }
    // Let Nextflow build the environment from environment.yml.
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    // Offline smoke test: start from the bundled RdRp domains and use a short
    // model list so it finishes in a few minutes.
    test {
        params.domains      = "${projectDir}/data/SSF56672_sequences.fasta"
        params.iqtree_extra = '-mset LG,WAG,JTT'
        params.outdir       = 'results_test'
    }
}

def stamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${stamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${stamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${stamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${stamp}.mmd" }
